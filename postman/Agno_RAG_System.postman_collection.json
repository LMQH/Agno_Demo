									"key": "file",
									"type": "file",
									"src": [],
									"description": "Markdown 格式文档文件"
								},
								{
									"key": "chunk_method",
									"value": "markdown",
									"type": "text",
									"description": "文档切分方法：recursive、markdown、semantic（默认：markdown）"
